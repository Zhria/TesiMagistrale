include kpmv3_out/Makefile.am.libasncodec

bin_PROGRAMS += asn1convert
asn1convert_CFLAGS = $(ASN_MODULE_CFLAGS) -DASN_PDU_COLLECTION 
asn1convert_CPPFLAGS = -I$(top_srcdir)/kpmv3_out/
asn1convert_LDADD = libasncodec.la
asn1convert_SOURCES = \
	kpmv3_out/converter-example.c\
	kpmv3_out/pdu_collection.c
regen: regenerate-from-asn1-source

regenerate-from-asn1-source:
	asn1c -fcompound-names -fincludes-quoted -fno-include-deps -gen-PER -no-gen-OER -pdu=all -D kpmv3_out e2sm_kpm_v03.00_modified.asn1

