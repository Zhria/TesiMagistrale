include ./testRC1.0.3/Makefile.am.libasncodec

bin_PROGRAMS += asn1convert
asn1convert_CFLAGS = $(ASN_MODULE_CFLAGS) -DASN_PDU_COLLECTION 
asn1convert_CPPFLAGS = -I$(top_srcdir)/./testRC1.0.3/
asn1convert_LDADD = libasncodec.la
asn1convert_SOURCES = \
	./testRC1.0.3/converter-example.c\
	./testRC1.0.3/pdu_collection.c
regen: regenerate-from-asn1-source

regenerate-from-asn1-source:
	asn1c -fcompound-names -D ./testRC1.0.3/ ./Downloads/e2sm_rc_v1_03_standard.asn

